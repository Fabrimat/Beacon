{
	"format_version": "1.21.0",
	"minecraft:item": {
		"description": {
			"identifier": "`f'{namespace}:paint'`",
			"menu_category": { "category": "items" }
		},
		"components": {
			"minecraft:max_stack_size": "`stack * 2`",
			"minecraft:display_name": { "value": "`label`" },
			"`[K(f'stf:tag_{c}', c=c) for c in colors]`": "`c.upper()`"
		}
	}
}
